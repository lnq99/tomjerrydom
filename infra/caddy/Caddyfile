# ---------------------------------------------------------------------------
# Caddyfile — TomJerryDom production reverse proxy
#
# Required env vars:
#   DOMAIN         = api.yourdomain.com      (Medusa backend)
#   MANAGER_DOMAIN = manager.yourdomain.com  (internal manager app)
#
# Caddy handles TLS automatically via Let's Encrypt.
# Storefront is on Cloudflare Pages — only the API and manager live here.
# ---------------------------------------------------------------------------

# Medusa API
{$DOMAIN} {
    reverse_proxy medusa:9000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        health_uri /health
        health_interval 15s
        health_timeout 5s
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    encode zstd gzip

    log {
        output stdout
        format json
    }
}

# Manager back-office (restrict to your IP in production via firewall, not here)
{$MANAGER_DOMAIN} {
    reverse_proxy manager:3100 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    encode zstd gzip

    log {
        output stdout
        format json
    }
}
