# =============================================================================
# Infrastructure
# =============================================================================
# Public domain for the Medusa API (used by Caddy for TLS + reverse proxy)
DOMAIN=api.example.com
MANAGER_DOMAIN=manager.example.com
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.example.com

# =============================================================================
# Medusa backend — core
# =============================================================================
DATABASE_URL=postgres://medusa:password@postgres:5432/medusa
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-jwt
COOKIE_SECRET=change-me-cookie

# CORS — comma-separated allowed origins
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001,http://localhost:3100
AUTH_CORS=http://localhost:3000,http://localhost:7001,http://localhost:3100

# =============================================================================
# Cloudflare R2 — asset storage + backups
# =============================================================================
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tomjerrydom-assets
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://assets.example.com

# Separate bucket for database backups (can be same bucket with a prefix)
BACKUP_R2_BUCKET=tomjerrydom-backups
# OpenNext ISR cache — separate bucket required by @opennextjs/cloudflare (set in storefront/wrangler.jsonc)
NEXT_INC_CACHE_R2_BUCKET=tomjerrydom-isr-cache

# =============================================================================
# YooKassa — payments + 54-ФЗ fiscal compliance
# =============================================================================
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# =============================================================================
# Storefront (Next.js) — public vars are safe to expose to the browser
# =============================================================================
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_REGION=ru
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.example.com

# =============================================================================
# Telegram bot (Cloudflare Worker secrets — set via wrangler secret put)
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# URL the Worker uses to reach Medusa (internal or public depending on topology)
MEDUSA_BACKEND_URL=https://api.example.com
MEDUSA_API_KEY=

# =============================================================================
# PostgreSQL — used by backup scripts running on the host (not inside Docker)
# =============================================================================
POSTGRES_DB=medusa
POSTGRES_USER=medusa
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=postgres
